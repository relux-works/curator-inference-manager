          },
          {
            "targetId": "global-codex-settings",
            "before": {
              "kind": "absent",
              "sha256": null,
              "mode": 0,
              "linkTarget": null
            },
            "after": {
              "kind": "file",
              "sha256": "aaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaaa",
